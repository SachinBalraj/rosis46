# MongoDB Atlas connection string (native mongodb driver)
# Create a database in MongoDB Atlas, then paste the connection string here.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Name of the MongoDB database (created in Atlas)
MONGODB_DB_NAME="bike_shop"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay test credentials (https://razorpay.com)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# NextAuth secret (generate with: npx auth secret)
AUTH_SECRET="generate_with_npx_auth_secret"

# Admin console login — username plus the bcrypt hash of the admin password
# (generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))")
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""